# ─────────────────────────────────────────────────────────────────────────────
# INFOGERAL — Variáveis de ambiente
# Copie este arquivo para .env e preencha os valores antes do deploy.
# NUNCA commite o arquivo .env real no git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Ambiente ──────────────────────────────────────────────────────────────────
NODE_ENV=production

# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=3000

# ── Banco de dados MySQL ──────────────────────────────────────────────────────
# Formato: mysql://usuario:senha@host:3306/nome_do_banco
DATABASE_URL=mysql://user:password@localhost:3306/infogeral

# ── Autenticação OAuth ────────────────────────────────────────────────────────
# Segredo para assinar os tokens de sessão JWT.
# Gere com: openssl rand -base64 48
JWT_SECRET=troque_por_um_segredo_aleatorio_forte_aqui

# ID do app registrado no portal OAuth (Manus)
VITE_APP_ID=seu_app_id_aqui

# URL base do portal OAuth (ex: https://manus.im)
OAUTH_SERVER_URL=https://manus.im
VITE_OAUTH_PORTAL_URL=https://manus.im

# openId do usuário que terá role=admin automático no primeiro login
OWNER_OPEN_ID=seu_open_id_aqui

# ── Armazenamento de arquivos (opcional) ──────────────────────────────────────
# Necessário apenas se usar upload de arquivos via storage.ts
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Checklist de deploy:
#  [ ] JWT_SECRET é aleatório e tem pelo menos 32 caracteres
#  [ ] DATABASE_URL aponta para banco de produção (não localhost)
#  [ ] .env está no .gitignore
#  [ ] NODE_ENV=production
#  [ ] O servidor roda atrás de HTTPS (Nginx/Caddy/Cloudflare)
#  [ ] Executou: pnpm add helmet express-rate-limit
#  [ ] Executou: pnpm db:push (para criar as tabelas)
# ─────────────────────────────────────────────────────────────────────────────
